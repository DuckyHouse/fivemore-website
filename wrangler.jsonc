{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-08-15",
	"name": "fivemore-landing",
	"assets": {
		"directory": "./public",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "none"
	},
	"routes": [
		{
			"pattern": "fivemore.duckyhouse.dev",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true
	}
}
